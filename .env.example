# Copy to .env and fill in your own values:  cp .env.example .env
# .env is gitignored and must never be committed.

# --- InfluxDB ---------------------------------------------------------------
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me
INFLUXDB_ORG=myorg
INFLUXDB_BUCKET=occupancy
INFLUXDB_ADMIN_TOKEN=generate-a-strong-token
# Token used by scripts/generate_data.py to write sample data
INFLUXDB_API_TOKEN=your-influxdb-api-token

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.example.com

# --- Microsoft Entra ID (Azure AD) SSO --------------------------------------
# From: Entra admin centre > App registrations > your app
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret
AZURE_ALLOWED_DOMAINS=yourdomain.onmicrosoft.com example.ie

# --- Cloudflare Tunnel ------------------------------------------------------
# From: Cloudflare Zero Trust > Networks > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
